<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="TickBox.UI.StartScreen">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Vertical" Spacing="50">
        <TextBlock Text="Welcome to TickBox!" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" />

        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="24">

            <Button Content="+" Width="30" Height="30" />
            <Button Content="/" Width="30" Height="30" />
            <Button Content="C" Width="30" Height="30" />
        </StackPanel>
    </StackPanel>
</UserControl>