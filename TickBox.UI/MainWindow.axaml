<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="TickBox.UI.MainWindow"
        Title="TickBox.UI">


    <!--UI Here-->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">

        <StackPanel Spacing="10">
            <TextBlock Text="Welcome to TickBox!" Width="250" FontWeight="Bold" FontSize="24"/>

            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Content="Create" Width="50" Height="50"/>
                <Button Content="List" Width="50" Height="50"/>
                <Button Content="Exit" Width="50" Height="50"/>
            </StackPanel>
        </StackPanel>

    </StackPanel>
</Window>

